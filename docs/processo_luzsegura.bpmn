<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_LuzSegura" targetNamespace="https://github.com/luz-segura/rpa" exporter="gerar_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Colab_LuzSegura">
    <bpmn:participant id="Pool_Cidadao" name="Cidadão" processRef="Proc_Cidadao" />
    <bpmn:participant id="Pool_Robo" name="Robô RPA Luz Segura (Python)" processRef="Proc_Robo" />
    <bpmn:participant id="Pool_Revisor" name="Revisor humano" processRef="Proc_Revisor" />
    <bpmn:participant id="Pool_Manut" name="Manutenção" processRef="Proc_Manut" />
    <bpmn:messageFlow id="mf1" name="relato + foto" sourceRef="c_app" targetRef="r_coleta" />
    <bpmn:messageFlow id="mf2" name="" sourceRef="s_rev" targetRef="v_ini" />
    <bpmn:messageFlow id="mf3" name="novo JSON em data/inbox" sourceRef="v_ree" targetRef="Pool_Robo" />
    <bpmn:messageFlow id="mf4" name="alerta" sourceRef="s_ale" targetRef="m_ini" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Cidadao" name="Cidadão" isExecutable="false">
    <bpmn:startEvent id="c_ini" name="Encontrou ponto escuro">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="c_foto" name="Fotografar e enviar (foto + GPS)">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="c_app" name="App grava relato (POST /relatos)">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="c_fim" name="Relato na fila">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" name="" sourceRef="c_ini" targetRef="c_foto" />
    <bpmn:sequenceFlow id="f2" name="" sourceRef="c_foto" targetRef="c_app" />
    <bpmn:sequenceFlow id="f3" name="" sourceRef="c_app" targetRef="c_fim" />
  </bpmn:process>
  <bpmn:process id="Proc_Robo" name="Robô RPA Luz Segura (Python)" isExecutable="false">
    <bpmn:startEvent id="r_ini" name="A cada 15 min">
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="r_ini_def"><bpmn:timeCycle>R/PT15M</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="r_trava" name="Obter trava e gerar run_id">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="r_ref" name="Carregar território, paradas e leituras LDR">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="r_coleta" name="Coletar lote de relatos (data/inbox)">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="r_sub" name="Processar cada relato do lote">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:startEvent id="s_ini" name="Relato">
        <bpmn:outgoing>s1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="s_ler" name="Ler JSON e validar schema">
        <bpmn:incoming>s1</bpmn:incoming>
        <bpmn:outgoing>s3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="s_err" name="" attachedToRef="s_ler">
        <bpmn:outgoing>s2</bpmn:outgoing>
        <bpmn:errorEventDefinition id="s_err_def" />
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="s_q1" name="Quarentena (JSON/schema)">
        <bpmn:incoming>s2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="g_dup" name="Já processado?">
        <bpmn:incoming>s3</bpmn:incoming>
        <bpmn:outgoing>s4</bpmn:outgoing>
        <bpmn:outgoing>s5</bpmn:outgoing>
        <bpmn:outgoing>s6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="s_dup" name="Ignorado (idempotente)">
        <bpmn:incoming>s4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="s_qc" name="Quarentena (conflito_id)">
        <bpmn:incoming>s5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="s_reg" name="Validar território, datas e foto">
        <bpmn:incoming>s6</bpmn:incoming>
        <bpmn:outgoing>s7</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="g_reg" name="Regras OK?">
        <bpmn:incoming>s7</bpmn:incoming>
        <bpmn:outgoing>s8</bpmn:outgoing>
        <bpmn:outgoing>s9</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="s_q2" name="Quarentena (motivo)">
        <bpmn:incoming>s8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="s_lgpd" name="Anonimizar: EXIF, PII e hash do contato">
        <bpmn:incoming>s9</bpmn:incoming>
        <bpmn:outgoing>s10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="g_abu" name="Contato &gt; 5 relatos/h?">
        <bpmn:incoming>s10</bpmn:incoming>
        <bpmn:outgoing>s11</bpmn:outgoing>
        <bpmn:outgoing>s12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="s_vis" name="Classificar iluminação (Visão ou fallback)">
        <bpmn:incoming>s12</bpmn:incoming>
        <bpmn:outgoing>s13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="g_conf" name="Confiança ≥ 0,60?">
        <bpmn:incoming>s13</bpmn:incoming>
        <bpmn:outgoing>s14</bpmn:outgoing>
        <bpmn:outgoing>s15</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="s_rev" name="Fila de revisão humana">
        <bpmn:incoming>s11</bpmn:incoming>
        <bpmn:incoming>s14</bpmn:incoming>
        <bpmn:incoming>s19</bpmn:incoming>
        <bpmn:messageEventDefinition id="s_rev_def" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="g_adq" name="Iluminação adequada?">
        <bpmn:incoming>s15</bpmn:incoming>
        <bpmn:outgoing>s16</bpmn:outgoing>
        <bpmn:outgoing>s17</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="s_imp" name="Improcedente (arquivado)">
        <bpmn:incoming>s16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="s_ldr" name="Cruzar com sensor LDR (40 m / 72 h)">
        <bpmn:incoming>s17</bpmn:incoming>
        <bpmn:outgoing>s18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="g_ldr" name="Sensor LDR contesta?">
        <bpmn:incoming>s18</bpmn:incoming>
        <bpmn:outgoing>s19</bpmn:outgoing>
        <bpmn:outgoing>s20</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="s_enr" name="Enriquecer: Open-Meteo, paradas e pontos sensíveis">
        <bpmn:incoming>s20</bpmn:incoming>
        <bpmn:outgoing>s21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="g_prox" name="Chamado aberto a ≤ 30 m?">
        <bpmn:incoming>s21</bpmn:incoming>
        <bpmn:outgoing>s22</bpmn:outgoing>
        <bpmn:outgoing>s23</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="s_mes" name="Mesclar no chamado (recorrência)">
        <bpmn:incoming>s22</bpmn:incoming>
        <bpmn:outgoing>s24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="s_cri" name="Criar chamado (checa reincidência)">
        <bpmn:incoming>s23</bpmn:incoming>
        <bpmn:outgoing>s25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="g_join" name="">
        <bpmn:incoming>s24</bpmn:incoming>
        <bpmn:incoming>s25</bpmn:incoming>
        <bpmn:outgoing>s26</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="s_pri" name="Prioridade explicável + SLA; gravar em transação e auditar">
        <bpmn:incoming>s26</bpmn:incoming>
        <bpmn:outgoing>s27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="g_p1" name="Prioridade P1?">
        <bpmn:incoming>s27</bpmn:incoming>
        <bpmn:outgoing>s28</bpmn:outgoing>
        <bpmn:outgoing>s29</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="s_ale" name="Disparar alerta (arquivo, webhook, Telegram)">
        <bpmn:incoming>s29</bpmn:incoming>
        <bpmn:outgoing>s30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="s_fim" name="Relato processado">
        <bpmn:incoming>s28</bpmn:incoming>
        <bpmn:incoming>s30</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="s1" name="" sourceRef="s_ini" targetRef="s_ler" />
      <bpmn:sequenceFlow id="s2" name="inválido" sourceRef="s_err" targetRef="s_q1" />
      <bpmn:sequenceFlow id="s3" name="" sourceRef="s_ler" targetRef="g_dup" />
      <bpmn:sequenceFlow id="s4" name="sim, idêntico" sourceRef="g_dup" targetRef="s_dup" />
      <bpmn:sequenceFlow id="s5" name="sim, conteúdo diferente" sourceRef="g_dup" targetRef="s_qc" />
      <bpmn:sequenceFlow id="s6" name="não" sourceRef="g_dup" targetRef="s_reg" />
      <bpmn:sequenceFlow id="s7" name="" sourceRef="s_reg" targetRef="g_reg" />
      <bpmn:sequenceFlow id="s8" name="não" sourceRef="g_reg" targetRef="s_q2" />
      <bpmn:sequenceFlow id="s9" name="sim" sourceRef="g_reg" targetRef="s_lgpd" />
      <bpmn:sequenceFlow id="s10" name="" sourceRef="s_lgpd" targetRef="g_abu" />
      <bpmn:sequenceFlow id="s11" name="sim" sourceRef="g_abu" targetRef="s_rev" />
      <bpmn:sequenceFlow id="s12" name="não" sourceRef="g_abu" targetRef="s_vis" />
      <bpmn:sequenceFlow id="s13" name="" sourceRef="s_vis" targetRef="g_conf" />
      <bpmn:sequenceFlow id="s14" name="não" sourceRef="g_conf" targetRef="s_rev" />
      <bpmn:sequenceFlow id="s15" name="sim" sourceRef="g_conf" targetRef="g_adq" />
      <bpmn:sequenceFlow id="s16" name="sim" sourceRef="g_adq" targetRef="s_imp" />
      <bpmn:sequenceFlow id="s17" name="não" sourceRef="g_adq" targetRef="s_ldr" />
      <bpmn:sequenceFlow id="s18" name="" sourceRef="s_ldr" targetRef="g_ldr" />
      <bpmn:sequenceFlow id="s19" name="sim" sourceRef="g_ldr" targetRef="s_rev" />
      <bpmn:sequenceFlow id="s20" name="não" sourceRef="g_ldr" targetRef="s_enr" />
      <bpmn:sequenceFlow id="s21" name="" sourceRef="s_enr" targetRef="g_prox" />
      <bpmn:sequenceFlow id="s22" name="sim" sourceRef="g_prox" targetRef="s_mes" />
      <bpmn:sequenceFlow id="s23" name="não" sourceRef="g_prox" targetRef="s_cri" />
      <bpmn:sequenceFlow id="s24" name="" sourceRef="s_mes" targetRef="g_join" />
      <bpmn:sequenceFlow id="s25" name="" sourceRef="s_cri" targetRef="g_join" />
      <bpmn:sequenceFlow id="s26" name="" sourceRef="g_join" targetRef="s_pri" />
      <bpmn:sequenceFlow id="s27" name="" sourceRef="s_pri" targetRef="g_p1" />
      <bpmn:sequenceFlow id="s28" name="não" sourceRef="g_p1" targetRef="s_fim" />
      <bpmn:sequenceFlow id="s29" name="sim" sourceRef="g_p1" targetRef="s_ale" />
      <bpmn:sequenceFlow id="s30" name="" sourceRef="s_ale" targetRef="s_fim" />
      <bpmn:textAnnotation id="a2"><bpmn:text>Open-Meteo: timeout 5 s, 3 tentativas com backoff exponencial e circuit breaker. Fora do ar? Usa horário fixo, marca clima_indisponivel e o relato segue.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="a2_as" sourceRef="a2" targetRef="s_enr" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="r_sla" name="Monitorar SLA e escalonar vencidos">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="r_exp" name="Exportar JSON e GeoJSON para o MVP">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="r_res" name="Registrar resumo e liberar trava">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="r_fim" name="Execução concluída">
      <bpmn:incoming>f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f10" name="" sourceRef="r_ini" targetRef="r_trava" />
    <bpmn:sequenceFlow id="f11" name="" sourceRef="r_trava" targetRef="r_ref" />
    <bpmn:sequenceFlow id="f12" name="" sourceRef="r_ref" targetRef="r_coleta" />
    <bpmn:sequenceFlow id="f13" name="" sourceRef="r_coleta" targetRef="r_sub" />
    <bpmn:sequenceFlow id="f14" name="" sourceRef="r_sub" targetRef="r_sla" />
    <bpmn:sequenceFlow id="f15" name="" sourceRef="r_sla" targetRef="r_exp" />
    <bpmn:sequenceFlow id="f16" name="" sourceRef="r_exp" targetRef="r_res" />
    <bpmn:sequenceFlow id="f17" name="" sourceRef="r_res" targetRef="r_fim" />
    <bpmn:textAnnotation id="a1"><bpmn:text>Qualquer erro inesperado em um relato: o arquivo vai para data/erros (dead letter), gera log ERROR e auditoria, e o lote CONTINUA. Recuperação: python main.py reprocessar-erros</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a1_as" sourceRef="a1" targetRef="r_sub" />
  </bpmn:process>
  <bpmn:process id="Proc_Revisor" name="Revisor humano" isExecutable="false">
    <bpmn:startEvent id="v_ini" name="Relato em revisão">
      <bpmn:outgoing>v1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="v_ini_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="v_ana" name="Analisar foto e motivo no painel">
      <bpmn:incoming>v1</bpmn:incoming>
      <bpmn:outgoing>v2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="v_gw" name="Aprovado?">
      <bpmn:incoming>v2</bpmn:incoming>
      <bpmn:outgoing>v3</bpmn:outgoing>
      <bpmn:outgoing>v4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="v_ree" name="Reenfileirar com rótulo humano">
      <bpmn:incoming>v3</bpmn:incoming>
      <bpmn:outgoing>v5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="v_rej" name="Rejeitar: relato improcedente">
      <bpmn:incoming>v4</bpmn:incoming>
      <bpmn:outgoing>v6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="v_fim1" name="Volta ao robô">
      <bpmn:incoming>v5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="v_fim2" name="Encerrado">
      <bpmn:incoming>v6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="v1" name="" sourceRef="v_ini" targetRef="v_ana" />
    <bpmn:sequenceFlow id="v2" name="" sourceRef="v_ana" targetRef="v_gw" />
    <bpmn:sequenceFlow id="v3" name="sim" sourceRef="v_gw" targetRef="v_ree" />
    <bpmn:sequenceFlow id="v4" name="não" sourceRef="v_gw" targetRef="v_rej" />
    <bpmn:sequenceFlow id="v5" name="" sourceRef="v_ree" targetRef="v_fim1" />
    <bpmn:sequenceFlow id="v6" name="" sourceRef="v_rej" targetRef="v_fim2" />
  </bpmn:process>
  <bpmn:process id="Proc_Manut" name="Manutenção" isExecutable="false">
    <bpmn:startEvent id="m_ini" name="Alerta P1 ou SLA vencido">
      <bpmn:outgoing>m1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="m_ini_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="m_con" name="Consertar o ponto em campo">
      <bpmn:incoming>m1</bpmn:incoming>
      <bpmn:outgoing>m2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="m_res" name="Marcar resolvido (PATCH /chamados)">
      <bpmn:incoming>m2</bpmn:incoming>
      <bpmn:outgoing>m3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="m_fim" name="Chamado resolvido">
      <bpmn:incoming>m3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="m1" name="" sourceRef="m_ini" targetRef="m_con" />
    <bpmn:sequenceFlow id="m2" name="" sourceRef="m_con" targetRef="m_res" />
    <bpmn:sequenceFlow id="m3" name="" sourceRef="m_res" targetRef="m_fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_LuzSegura"><bpmndi:BPMNPlane id="Plano" bpmnElement="Colab_LuzSegura">
    <bpmndi:BPMNShape id="Pool_Cidadao_di" bpmnElement="Pool_Cidadao" isHorizontal="true"><dc:Bounds x="20" y="20" width="1920" height="110" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Pool_Robo_di" bpmnElement="Pool_Robo" isHorizontal="true"><dc:Bounds x="20" y="150" width="1920" height="620" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Pool_Revisor_di" bpmnElement="Pool_Revisor" isHorizontal="true"><dc:Bounds x="20" y="790" width="1920" height="150" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Pool_Manut_di" bpmnElement="Pool_Manut" isHorizontal="true"><dc:Bounds x="20" y="960" width="1920" height="120" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c_ini_di" bpmnElement="c_ini"><dc:Bounds x="84" y="59" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="50" y="95" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c_foto_di" bpmnElement="c_foto"><dc:Bounds x="155" y="47" width="120" height="56" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c_app_di" bpmnElement="c_app"><dc:Bounds x="305" y="47" width="130" height="56" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c_fim_di" bpmnElement="c_fim"><dc:Bounds x="474" y="59" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="440" y="95" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="r_ini_di" bpmnElement="r_ini"><dc:Bounds x="84" y="199" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="50" y="235" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="r_trava_di" bpmnElement="r_trava"><dc:Bounds x="150" y="185" width="110" height="60" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="r_ref_di" bpmnElement="r_ref"><dc:Bounds x="285" y="185" width="120" height="60" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="r_coleta_di" bpmnElement="r_coleta"><dc:Bounds x="430" y="185" width="120" height="60" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="r_sub_di" bpmnElement="r_sub" isExpanded="true"><dc:Bounds x="60" y="290" width="1850" height="460" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="r_sla_di" bpmnElement="r_sla"><dc:Bounds x="1440" y="185" width="120" height="60" /></bpmndi:BPMNShape>
