# Copie para .env (copy .env.example .env). O .env NUNCA vai para o Git.

# Senha da API: exigida pelos botões do painel e pelas rotas que alteram dados (header X-API-Key)
LUZSEGURA_API_KEY=troque-por-uma-chave-longa-e-aleatoria

# Valor secreto usado para transformar o contato do cidadão em hash (LGPD)
SALT_PSEUDONIMIZACAO=troque-por-outro-valor-aleatorio

# API de clima. Para demonstrar a falha no vídeo, troque por https://api.open-meteo.invalido/v1/forecast
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Os demais parâmetros (API de Visão, webhook, Telegram e limites das regras) já têm valor padrão.
# A lista completa está em src/luzsegura_rpa/config.py.
