# Copie para .env e ajuste. O .env NUNCA vai para o Git.

# ---- Segurança
LUZSEGURA_API_KEY=troque-por-uma-chave-longa-e-aleatoria
SALT_PSEUDONIMIZACAO=troque-por-outro-valor-aleatorio
CORS_ORIGENS=*

# ---- Integrações (todas opcionais: sem elas o robô usa fallback)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# URL do componente de Visão Computacional (POST multipart "foto" -> {"rotulo","confianca"})
VISAO_API_URL=
# Webhook para alertas (Teams, Discord, n8n, Power Automate...). Recebe JSON.
WEBHOOK_ALERTA_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Resiliência
HTTP_TIMEOUT_S=5
TENTATIVAS_HTTP=3
BACKOFF_BASE_S=0.5
FALHAS_PARA_ABRIR_CIRCUITO=3

# ---- Regras de negócio (calibráveis sem mexer no código)
RAIO_DEDUPLICACAO_M=30
RAIO_LDR_M=40
JANELA_LDR_HORAS=72
LUX_MINIMO=15
LIMIAR_CONFIANCA=0.60
RAIO_PARADA_M=150
RAIO_PONTO_SENSIVEL_M=100
JANELA_REINCIDENCIA_DIAS=30
MAX_IDADE_RELATO_DIAS=7
MAX_FOTO_MB=5
MAX_RELATOS_CONTATO_HORA=5
MINUTOS_MANUAIS_POR_RELATO=6
FUSO_HORARIO=America/Sao_Paulo
